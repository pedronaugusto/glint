{
  "glint": {
    "rules": [
      {
        "id": "P003",
        "level": "gate"
      },
      {
        "id": "Z026",
        "level": "gate"
      },
      {
        "id": "A004",
        "level": "gate"
      },
      {
        "id": "A005",
        "level": "gate"
      },
      {
        "id": "A001",
        "level": "gate"
      },
      {
        "id": "A002",
        "level": "gate"
      },
      {
        "id": "A003",
        "level": "gate"
      }
    ],
    "escapes": {
      "no-danger": 2,
      "internal": 1,
      "design": 2
    }
  },
  "fuzz": {
    "trusted": {
      "parse": "a rule's name, from the configuration the repository writes for itself, looked up in a table",
      "parseConfigured": "a rule's name, from the configuration the repository writes for itself, looked up in its tables"
    }
  },
  "sources": [
    "src"
  ],
  "glint_paths": [
    "src",
    "ci",
    "bench",
    "build.zig"
  ],
  "test_roots": [
    "src/tests.zig",
    "src/glint.zig"
  ],
  "test_dependencies": [
    "shakedown"
  ],
  "extra_checks": [
    [
      "zig",
      "build",
      "check-consumer"
    ],
    [
      "zig",
      "build",
      "check-project"
    ],
    [
      "zig",
      "build",
      "check-helper"
    ],
    [
      "zig",
      "build",
      "check-source-policy"
    ],
    [
      "zig",
      "build",
      "check-token-portable"
    ]
  ],
  "shipped": {
    "docs": "Lasting model, rule, completion and adopter contracts in docs/design.md are linked from README.",
    "examples": "Standalone project-owned rule and CLI entry used by adopters with the public build helper."
  }
}
