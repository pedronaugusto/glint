{
  "glint": {"rules": [{"id": "P001", "level": "gate"}, {"id": "P003", "level": "gate"}]},
  "sources": [
    "src"
  ],
  "glint_paths": [
    "src",
    "examples/project.zig",
    "examples/report.zig",
    "ci",
    "bench",
    "build.zig"
  ],
  "test_roots": [
    "src/tests.zig",
    "src/glint.zig"
  ],
  "test_dependencies": [
    "shakedown"
  ],
  "extra_checks": [
    [
      "zig",
      "build",
      "check-consumer"
    ],
    [
      "zig",
      "build",
      "check-project"
    ],
    [
      "zig",
      "build",
      "check-helper"
    ],
    [
      "zig",
      "build",
      "check-source-policy"
    ],
    [
      "zig",
      "build",
      "check-token-portable"
    ]
  ],
  "shipped": {
    "docs": "Lasting model, rule, completion and adopter contracts in docs/design.md are linked from README.",
    "examples": "Standalone project-owned rule and CLI entry used by adopters with the public build helper."
  }
}
