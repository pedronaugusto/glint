        // matrix A021: the same, the guard copied out by @memcpy
        "A021/memory/mx-a21-memcpy_guard/hole.zig",
        // matrix A021: the same, the labeled block whose break carries the guard is taken as its block
        "A021/jump/mx-a21-label_break_guard/hole.zig",
        // matrix A021: held is a span of tokens, so a loop's next pass taking a lock written earlier is not inside it
        "A021/jump/mx-a21-loop_carries_guard/hole.zig",
        // matrix A021: the same, a deferred acquisition written before the guard but run while it is held
        "A021/deferred/mx-a21-defer_runs_while_held/hole.zig",
        // matrix A021: one acquisition run by each pass of a loop is never held against itself
        "A021/capture/mx-a21-loop_capture_each/hole.zig",
        // matrix A021: the same, an inline loop
        "A021/inline_loop/mx-a21-inline_each_lock/hole.zig",
        // matrix A021: an acquisition is only a `receiver.acquire*(` call: a callee returning a guard is none
        "A021/call/mx-a21-helper_returns_guard/hole.zig",
        // matrix A021: the same, acquire called by @call
        "A021/call/mx-a21-call_builtin/hole.zig",
        // matrix A021: the same, acquire named by @field
