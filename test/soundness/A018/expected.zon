.{
    .open = .{
        // matrix A018: an error's name in a local before the write is not seen; only `@errorName` as the argument is
        "assignment/mx-name_in_local/hole.zig",
        // matrix A018: an error's name destructured before the write is not seen
        "destructure/mx-destructured_name/hole.zig",
        // matrix A018: an error's name's bytes, a loop's capture, are not seen
        "capture/mx-byte_capture/hole.zig",
        // matrix A018: a write called through `@field` is no field-access call, so it is not read
        "field/mx-method_by_field/hole.zig",
        // matrix A018: a slice of an error's name is not seen
        "address/mx-name_sliced/hole.zig",
        // matrix A018: an error's name a helper returns is not seen
        "call/mx-name_from_helper/hole.zig",
        // matrix A018: `{t}` prints an error's name with no `@errorName` in the file, which the rule needs to start
        "call/mx-format_t/hole.zig",
        // matrix A018: `std.Io.Writer.writeAll(w, ...)` judges the namespace before the dot as the writer, not `w`
        "call/mx-namespaced_call/hole.zig",
        // matrix A018: an error's name a labeled block breaks with is not seen
        "jump/mx-labeled_block_text/hole.zig",
        // matrix A018: an error's name made under `comptime` is not seen
        "compile_time/mx-comptime_name/hole.zig",
        // matrix A018: an error's name's bytes through a bit operator are not seen
        "operator/mx-name_lowercased/hole.zig",
        // matrix A018: an error's name through `@as` is not seen
        "conversion/mx-as_slice/hole.zig",
        // matrix A018: an error's name as an `orelse` fallback is not seen
        "unwrap/mx-orelse_name/hole.zig",
        // matrix A018: an error's name in an array handed by address to `writeVecAll` is not seen
        "aggregate/mx-vector_parts/hole.zig",
        // matrix A018: an error's name in a `++` concatenation is not seen
        "aggregate/mx-concat_name/hole.zig",
        // matrix A018: an error's name copied by `@memcpy` into the bytes written is not seen
        "memory/mx-memcpy_name/hole.zig",
        // matrix A018: an error's name an `if` expression chooses is not seen
        "branch/mx-if_name/hole.zig",
    },
}
