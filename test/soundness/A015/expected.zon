.{
    // A015 is a rule aegis declares (its lint_rules, read from the pinned aegis): a handle type
    // reaching a field's type through each way a type is held, held by value, and the same type
    // borrowed by pointer.
    // A field's type is evaluated as the program compiles, where no statement runs: no deferred
    // statement and no memory a load or store moves reaches it.
    .na = .{ .deferred, .memory },
    .open = .{
        // review b9 precision: a union field written without a type, an incomplete run
        "field/b9-untyped_union_field/twin.zig",
    },
}
