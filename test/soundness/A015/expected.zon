// An owner held in a field (a File, Dir, Stream, Server or Child, a struct) is no operand
// of any arithmetic, bit or comparison operator: A015's value cannot pass through one.
.{
    .na = .{.operator},
    .open = .{
        // glint-b precision: A015 leaves a type function's field read by a destructure undecided
        "destructure/glintb-tuple/twin.zig",
        // warp-fast precision: Facts.resolve reads no `@call` as a call of its callee, so what a
        // generic makes through one does not resolve and its binding is undecided (was flagged)
        "call/wf-view-by-call/twin.zig",
    },
}
