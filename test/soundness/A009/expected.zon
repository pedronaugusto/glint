    .no_hole = .{ .assignment, .destructure, .capture, .address, .deferred, .jump, .inline_loop, .compile_time, .operator, .conversion, .unwrap, .memory, .branch },
    .no_twin = .{ .assignment, .destructure, .capture, .address, .deferred, .jump, .inline_loop, .compile_time, .operator, .conversion, .unwrap, .memory, .branch },
}
