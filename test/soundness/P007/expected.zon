.{
    .open = .{
        // review 6 precision: a call through a function-pointer field whose only stored function writes whole
        // review 6 precision: the safe holder of a function-pointer field
    },
    // The rows whose holes were the interface-recovery idiom's (a copy of the interface field
    // behind `@alignCast(@fieldParentPtr(...))`), which P007 does not read (glint-0.8-shape,
    // what the bans do not claim): assignment, capture, field, address, compile_time, aggregate,
    // memory.
    .no_hole = .{ .assignment, .destructure, .capture, .field, .address, .deferred, .jump, .inline_loop, .compile_time, .operator, .conversion, .unwrap, .aggregate, .memory, .branch },
    .no_twin = .{ .field, .deferred, .inline_loop, .operator, .conversion, .aggregate, .branch },
}
