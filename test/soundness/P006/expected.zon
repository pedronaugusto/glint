// A declaration is reached by a name, and memory holds none: a pointer copied through bytes
// was made by a reference that is P006's site.
.{
    .na = .{.memory},
    // A namespace captured or unwrapped from an optional reaches `print` by a receiver glint does
    // not resolve, and `print` is not std.debug's name alone: nothing, under the unique-name
    // reading (glint-0.8-shape).
    .no_hole = .{ .capture, .unwrap },
    .no_twin = .{ .capture, .unwrap },
}
