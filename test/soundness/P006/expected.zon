// A declaration is reached by a name, and memory holds none: a pointer copied through bytes
// was made by a reference that is P006's site.
.{
    .na = .{.memory},
    .open = .{
        // P006 precision: an if between two of std's namespaces is not resolved, so the member it reaches is undecided
        "branch/p06-15_namespace_chosen/twin.zig",
        // P006: a member @field names by a constant is skipped, never undecided (Governed.sites reads only a literal name)
        "compile_time/p06-10_field_name_const/hole.zig",
        // P006: a member @field names by an inline for's capture is skipped, never undecided (as above)
        "inline_loop/p06-09_field_name_unrolled/hole.zig",
        // P006: a member @field names by a concatenation is skipped, never undecided (as above)
        "operator/p06-11_field_name_concatenated/hole.zig",
    },
}
