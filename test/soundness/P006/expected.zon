// A declaration is reached by a name, and memory holds none: a pointer copied through bytes
// was made by a reference that is P006's site.
.{
    .na = .{.memory},
    .open = .{
        // A var only compile-time calls evaluate may hold a type, but the value model does not
        // yet tell a pointer type from a pointer (Value.pointer is both): the var reads as its
        // first value (Facts.compileTime).
        "assignment/p06-28_compile_time_call_var/hole.zig",
    },
}
