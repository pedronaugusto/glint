.{
    .no_hole = .{
        // The callee does not resolve; a miss is allowed: a function stored by @atomicStore
        // and called through @atomicLoad.
        .memory,
    },
    .na = .{
        // No operator yields a function: arithmetic, bit and comparison operators take
        // numbers, bools and many-item pointers, never a callable.
        .operator,
    },
}
