.{
    .open = .{
        // review 8 M5: std.meta.fieldNames(S) reflects on its type parameter (@typeInfo(T) in its body); Governed.reflectsParameter does not reach it yet
        "call/std_field_names/hole.zig",
    },
    // A001 is a rule aegis declares (its lint_rules, read from the pinned aegis): sites it reports
