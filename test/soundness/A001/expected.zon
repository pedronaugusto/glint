    .no_hole = .{ .assignment, .destructure, .capture, .address, .deferred, .jump, .inline_loop, .compile_time, .operator, .unwrap, .aggregate, .memory, .branch },
    .no_twin = .{ .assignment, .destructure, .capture, .address, .deferred, .jump, .inline_loop, .compile_time, .operator, .unwrap, .aggregate, .memory, .branch },
}
