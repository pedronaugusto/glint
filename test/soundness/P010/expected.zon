.{
    .open = .{
        // review b9: `orelse { unreachable; }`, the block form of `orelse unreachable`, traps with no reason
        "unwrap/b9-orelse_unreachable_block/hole.zig",
    },
    // The rule reads syntax and written types where it says; other rows carry no case of it yet.
    .no_hole = .{ .assignment, .destructure, .capture, .field, .address, .call, .deferred, .jump, .inline_loop, .compile_time, .operator, .conversion, .aggregate, .memory, .branch },
    .no_twin = .{ .assignment, .destructure, .capture, .field, .address, .call, .deferred, .jump, .inline_loop, .compile_time, .operator, .conversion, .aggregate, .memory, .branch },
}
