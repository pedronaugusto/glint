.{
    // The rule reads a call of std's Io.File.writer and the stream its receiver is, as written or held in a const; other rows carry no case of it yet.
    .no_hole = .{ .destructure, .capture, .field, .address, .deferred, .jump, .inline_loop, .compile_time, .operator, .conversion, .unwrap, .aggregate, .memory, .branch },
    .no_twin = .{ .destructure, .capture, .field, .address, .deferred, .jump, .inline_loop, .compile_time, .operator, .conversion, .unwrap, .aggregate, .memory, .branch },
}
