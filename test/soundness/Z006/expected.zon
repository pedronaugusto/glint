.{
    .no_hole = .{ .assignment, .destructure, .capture, .field, .address, .call, .deferred, .jump, .inline_loop, .operator, .conversion, .unwrap, .aggregate, .memory, .branch },
    .no_twin = .{ .assignment, .destructure, .capture, .field, .address, .call, .deferred, .jump, .inline_loop, .operator, .conversion, .unwrap, .aggregate, .memory, .branch },
