.{
    .na = .{
        // Zig refuses `_ = err` ("error set is discarded"); an error stored is kept, not dropped.
        .assignment,
        // A destructure stores an error into places, keeping it.
        .destructure,
        // @field names a field or declaration; an error is no container to name one of.
        .field,
        // A pointer to an error keeps it; no handler drops one by taking its address.
        .address,
        // A jump out of a handler (`catch return`, `catch break`) is how the contract answers an
        // error; a jump that carries the error passes it on.
        .jump,
        // An operator only reads an error (`err == error.X`); the handler around it is the
        // branch row.
        .operator,
        // An aggregate holding an error keeps it.
        .aggregate,
        // Atomics and @memcpy store an error into memory, keeping it.
        .memory,
    },
    .open = .{
        // matrix Z026: only a catch whose handler is a block of no statements is judged
        "branch/mx-z26-switch_else_empty/hole.zig",
        // matrix Z026: the same, a handler that hands the error to a callee that drops it
        "call/mx-z26-callee_drops/hole.zig",
        // matrix Z026: the same, an if's error captured by _ with an empty branch
        "capture/mx-z26-if_else_discard/hole.zig",
        // matrix Z026: the same, a while's else
        "capture/mx-z26-while_else_discard/hole.zig",
        // matrix Z026: the same, an errdefer's if
        "deferred/mx-z26-errdefer_discard/hole.zig",
        // matrix Z026: the same, @intFromError discarded
        "conversion/mx-z26-int_from_error/hole.zig",
        // matrix Z026: the same, an empty block in parentheses
        "unwrap/mx-z26-grouped_empty_handler/hole.zig",
    },
}
