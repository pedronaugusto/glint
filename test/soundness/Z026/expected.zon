.{
    .open = .{
        // review b9: a handler `return {}`, a bare return with the void value written, is empty
        "jump/b9-return_void_value/hole.zig",
        // review b9: a handler `break :blk {}` to its own label, a bare break with the void value written, is empty
        "jump/b9-break_void_value/hole.zig",
    },
    .na = .{
        // Zig refuses `_ = err` ("error set is discarded"); an error stored is kept, not dropped.
        .assignment,
        // A destructure stores an error into places, keeping it.
        .destructure,
        // A pointer to an error keeps it; no handler drops one by taking its address.
        .address,
        // A call is not empty; no callee body is read (callee_only_returns, callee_drops: deleted).
        .call,
        // An operator only reads an error (`err == error.X`); the handler around it is the
        // branch row.
        .operator,
        // Atomics and @memcpy store an error into memory, keeping it.
        .memory,
    },
}
