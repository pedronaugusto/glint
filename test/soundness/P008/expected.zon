.{
    .na = .{
        // a defer runs statements at a scope's exit; it yields no type to a signature or a field
        .deferred,
        // a type is comptime-only: no builtin moves one through memory
        .memory,
    },
    .outside = .{
        // generic: a comptime type parameter of a pub function is whatever a consumer's call
        // binds; the program's own call binding an integer is not every call
        "compile_time/mx-generic_ids/hole.zig",
        // generic: an `anytype` id of a pub function is whatever a consumer's call gives
        "compile_time/r8-a16-anytype_ids/hole.zig",
    },
}
