.{
    .no_hole = .{
        .inline_loop,
        .operator,
        .unwrap,
        // The rule reads a type written by name in the signature.
        .branch,
        .call,
        .conversion,
        .field,
        .jump,
    },
    .no_twin = .{
        .inline_loop,
        .operator,
        .unwrap,
        // The rule reads a type written by name in the signature.
        .branch,
        .conversion,
        .field,
        .jump,
    },
    .na = .{
        // A destructure writes places in a body; no public declaration takes its type from one.
        .destructure,
        // A capture binds a payload inside a body, where nothing is public.
        .capture,
        // A deferred statement runs at a scope's exit and gives no type.
        .deferred,
        // Memory builtins move values at run time; a public declaration's type is fixed as the
        // program compiles.
        .memory,
    },
}
