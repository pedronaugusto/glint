.{
    // The rule reads syntax and written types where it says; other rows carry no case of it yet.
    .no_hole = .{ .assignment, .destructure, .capture, .field, .address, .call, .deferred, .inline_loop, .compile_time, .operator, .conversion, .unwrap, .aggregate, .memory, .branch },
    .no_twin = .{ .assignment, .destructure, .capture, .field, .address, .call, .deferred, .inline_loop, .compile_time, .operator, .conversion, .unwrap, .aggregate, .memory, .branch },
}
