.{
    .open = .{
        // matrix A011: a decl literal `.fromMilliseconds(ms)` is no site; Governed.sites reads identifiers, members and @field only
        "assignment/mx-decl_literal_store/hole.zig",
        // matrix A011: a decl literal argument (`io.sleep(.fromMilliseconds(ms), ...)`) is no site
        "call/mx-decl_literal_argument/hole.zig",
        // matrix A011: `return .fromMilliseconds(ms)` is no site
        "jump/mx-return_decl_literal/hole.zig",
        // matrix A011: decl literals in a switch's prongs are no sites
        "branch/mx-decl_literal_switch/hole.zig",
        // matrix A011: a decl literal on orelse's right is no site
        "unwrap/mx-orelse_decl_literal/hole.zig",
        // matrix A011: a decl literal under @as is no site
        "conversion/mx-as_decl_literal/hole.zig",
        // matrix A011: a struct literal's `.nanoseconds = raw` is no site: std's Duration made with no door
        "aggregate/mx-struct_literal_nanoseconds/hole.zig",
        // matrix A011: a decl literal nested in a Timeout literal is no site
        "aggregate/mx-nested_timeout_literal/hole.zig",
        // matrix A011: @field with a name held in a constant is skipped, neither resolved nor undecided
        "field/mx-computed_door_name/hole.zig",
        // matrix A011: @field with a concatenated name is skipped, neither resolved nor undecided
        "compile_time/mx-concatenated_name/hole.zig",
        // matrix A011: @field by a reflected declaration's name is skipped, neither resolved nor undecided
        "inline_loop/mx-reflected_constant/hole.zig",
        // matrix A011: sameUnit clears a comparison with any field spelled `nanoseconds`, std's or not
        "operator/mx-wire_named_nanoseconds/hole.zig",
        // matrix A011: a raw count copied into std's Duration's bytes crosses no door the rule reads
        "memory/mx-memcpy_raw/hole.zig",
    },
}
